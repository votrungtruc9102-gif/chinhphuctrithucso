rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidGrade(grade) {
      return (grade is number && grade >= 6 && grade <= 9) || grade == 'all';
    }

    function isValidTextbook(data) {
      return data.id is string && data.id.size() <= 128
        && isValidGrade(data.grade)
        && data.subjectId is string && data.subjectId.size() <= 64
        && data.title is string && data.title.size() <= 255
        && data.bookUrl is string && data.bookUrl.size() <= 2048
        && data.status in ['published', 'hidden']
        && (!('embedUrl' in data) || (data.embedUrl is string && data.embedUrl.size() <= 2048))
        && (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2048))
        && (!('description' in data) || (data.description is string && data.description.size() <= 4096))
        && (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 128))
        && (!('bookSet' in data) || (data.bookSet is string && data.bookSet.size() <= 128))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 128))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 128));
    }

    match /textbooks/{textbookId} {
      allow get, list: if true;
      allow create, update: if isValidId(textbookId) && isValidTextbook(request.resource.data);
      allow delete: if isValidId(textbookId);
    }
  }
}
